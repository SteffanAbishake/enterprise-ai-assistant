# Local mode makes NO LLM, Pinecone or LangSmith requests.
APP_MODE=local
# Set separate random values; frontend asks for the selected user's key.
VIEWER_KEY=replace-with-a-long-viewer-secret
ANALYST_KEY=replace-with-a-long-analyst-secret
ADMIN_KEY=replace-with-a-long-admin-secret
# Live mode requires these settings. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=demo-bank-v1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-assistant
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
TOKEN_CAPACITY=20
TOKEN_REFILL_PER_SECOND=0.2
TOOL_TIMEOUT_SECONDS=20
MCP_ENABLED=false
